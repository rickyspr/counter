# Fixes a Swift 6.2 / Xcode 26 type-inference ambiguity in
# expo-modules-jsi that breaks `npx expo run:ios` builds.
# Upstream: https://github.com/expo/expo/issues/47957
# Remove this patch once expo-modules-jsi ships the fix in a release
# newer than 57.0.4.
diff --git a/apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift b/apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift
index eb1cc942ba5ec3ff7e359be3b0a3822b24685fe9..0fe08a50aa4abc81b1a6bf29257362790d7c7daf 100644
--- a/apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift
+++ b/apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift
@@ -50,7 +50,10 @@ let maxJavaScriptDateMilliseconds: Double = 8_640_000_000_000_000
 /// faithful to `new Date(number)`; the `Date`/string branches pass an already-clipped `getTime()` through.
 @usableFromInline
 func dateFromMilliseconds(_ milliseconds: Double) throws -> Date {
-  guard milliseconds.isFinite, abs(milliseconds) <= maxJavaScriptDateMilliseconds else {
+  guard milliseconds.isFinite,
+    milliseconds >= -8_640_000_000_000_000.0,
+    milliseconds <= 8_640_000_000_000_000.0
+  else {
     throw InvalidDateException()
   }
   return Date(timeIntervalSince1970: milliseconds.rounded(.towardZero) / 1000.0)
